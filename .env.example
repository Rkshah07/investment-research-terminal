# Copy this file to .env and fill in your keys (used by cli.py / list_models.py / app.py locally).
# On Streamlit Community Cloud, set these under App settings -> Secrets instead
# (as a TOML block: GOOGLE_API_KEY = "...") — see README for details.

# Google AI Studio key for Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Tavily search API key (free tier) — https://tavily.com
TAVILY_API_KEY=

# Alpha Vantage key (free tier) — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
